{
  "name": "remotion-kinetic-typography-vertical",
  "version": "1.0.0",
  "description": "Vertical 9:16 2D Kinetic Typography & Audio-Synced Motion Graphics in Remotion",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render Main out/video.mp4 --concurrency=2",
    "still": "remotion still Main out/still.png --frame=90",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "@remotion/google-fonts": "4.0.242",
    "@remotion/media-utils": "4.0.242",
    "@remotion/noise": "4.0.242",
    "@remotion/paths": "4.0.242",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
